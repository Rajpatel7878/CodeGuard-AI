[TEMPLATE]
# Backend environment variables. Copy this file to `.env` and adjust as needed.
# Never commit a real `.env` file or real credentials.

APP_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite by default. Relative paths resolve from the directory uvicorn is started in,
# so run `uvicorn app.main:app` from `backend/`.
DATABASE_URL=sqlite:///./codeguard.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hard limit on submitted source code (characters).
MAX_CODE_LENGTH=200000

# --- Authentication & Security -----------------------------------------------
# Generate a strong secret key for JWT signing. Use: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Per-IP limits on the auth endpoints (register/login/password reset).
# Set to false to disable, for example in automated tests.
RATE_LIMIT_ENABLED=true

# --- Google OAuth ------------------------------------------------------------
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- GitHub OAuth ------------------------------------------------------------
# Get credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- OpenRouter AI analysis --------------------------------------------------
# Default provider. Get a key from https://openrouter.ai/keys and paste it here.
# The key is read by the backend only. It is never sent to the frontend, never
# logged, and never included in API responses. Keep this file out of Git.
OPENROUTER_API_KEY=

# OpenRouter endpoint and model. `openrouter/free` is the Free Models Router,
# which picks a free model per request and reports it in the response.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Per-attempt request timeout, total attempts, and the pause after HTTP 429.
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_QUOTA_COOLDOWN_SECONDS=300

# Attribution headers sent with every OpenRouter request.
OPENROUTER_HTTP_REFERER=https://code-guard-ai-rho.vercel.app
OPENROUTER_APP_TITLE=ALPHA CodeGuard AI

# Preferred AI provider: "openrouter" or "gemini". If the preferred provider
# has no API key but the other one does, the configured provider is used.
DEFAULT_LLM_PROVIDER=openrouter

# --- Gemini AI analysis (alternative provider) -------------------------------
# Get a key from https://aistudio.google.com/apikey and paste it here.
# The key is read by the backend only. It is never sent to the frontend, never
# logged, and never included in API responses. Keep this file out of Git.
GEMINI_API_KEY=

# Model id. `gemini-3.8-flash` is the current stable Flash model.
# See https://ai.google.dev/gemini-api/docs/models for the supported list.
GEMINI_MODEL=gemini-3.8-flash

# Per-attempt request timeout in seconds.
GEMINI_TIMEOUT_SECONDS=45

# Total attempts per request (1 = no retries). Retries use exponential backoff
# for transient failures: 5xx/408 responses, timeouts, and network errors.
# Quota errors (HTTP 429), invalid keys, unknown models, and malformed requests
# are never retried, because retrying an exhausted free-tier quota only wastes
# more quota.
GEMINI_MAX_ATTEMPTS=3

# Review mode. "combined" (default) sends ONE request that analyzes bugs,
# security, performance, and code quality together, which uses a quarter of the
# quota of per-agent review. "per_agent" gives each of the four agents its own
# request and is kept for comparison or when a single category needs deeper
# focus.
GEMINI_REVIEW_MODE=combined

# After a quota-exceeded (HTTP 429) response, stop calling Gemini for this many
# seconds so a review never burns more quota on a limit that is already gone.
GEMINI_QUOTA_COOLDOWN_SECONDS=300

# --- Legacy provider settings -----------------------------------------------
# Only OpenRouter and Gemini are implemented. These are kept so older
# deployments still load; DEFAULT_LLM_PROVIDER above wins when set. A legacy
# LLM_PROVIDER value of "gemini" or "openrouter" is still honored.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
