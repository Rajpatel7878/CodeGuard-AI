[TEMPLATE]
# Backend environment variables. Copy this file to `.env` and adjust as needed.
# Never commit a real `.env` file or real credentials.

APP_ENV=development
FRONTEND_URL=http://localhost:5173

# SQLite by default. Relative paths resolve from the directory uvicorn is started in,
# so run `uvicorn app.main:app` from `backend/`.
DATABASE_URL=sqlite:///./codeguard.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hard limit on submitted source code (characters).
MAX_CODE_LENGTH=200000

# --- Authentication & Security -----------------------------------------------
# Generate a strong secret key for JWT signing. Use: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Per-IP limits on the auth endpoints (register/login/password reset).
# Set to false to disable, for example in automated tests.
RATE_LIMIT_ENABLED=true

# --- Google OAuth ------------------------------------------------------------
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- GitHub OAuth ------------------------------------------------------------
# Get credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# --- Gemini AI analysis ------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey and paste it here.
# The key is read by the backend only. It is never sent to the frontend, never
# logged, and never included in API responses. Keep this file out of Git.
GEMINI_API_KEY=

# Model id. `gemini-3.8-flash` is the current stable Flash model.
# See https://ai.google.dev/gemini-api/docs/models for the supported list.
GEMINI_MODEL=gemini-3.8-flash

# Per-attempt request timeout in seconds.
GEMINI_TIMEOUT_SECONDS=45

# Total attempts per review (1 = no retries). Retries use exponential backoff
# for transient failures: 429 rate limits, 5xx/408 responses, timeouts, and
# network errors. Invalid keys, unknown models, and malformed requests are not
# retried.
GEMINI_MAX_ATTEMPTS=3

# --- Legacy provider settings -----------------------------------------------
# Only Gemini is implemented. These are kept so older deployments still load;
# set GEMINI_API_KEY above to enable AI analysis.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
